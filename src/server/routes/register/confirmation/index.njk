{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukPanel({
        titleText: heading
      }) }}

      <p class="govuk-body">You will receive a confirmation email.</p>

      <h2 class="govuk-heading-m">What happens next</h2>

      <p class="govuk-body">
        New registrations may take up to 24 hours to appear in your cattle on holding list. You will receive a notification if your registrations are successful or we need further information.
      </p>

      {{ govukButton({
        text: "Return to the homepage",
        href: homeHref
      }) }}
    </div>
  </div>
{% endblock %}
