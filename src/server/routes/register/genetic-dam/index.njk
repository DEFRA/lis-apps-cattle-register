{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "form/macro.njk" import lisForm with context %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: backLinkHref
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorList.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        }) }}
      {% endif %}

      <span class="govuk-caption-l">Official animal ear tag number: {{ calfEarTagNumber }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      {% call lisForm({ action: formAction }) %}
        {{ appAutocomplete({
          id: "geneticDamEarTagNumber",
          name: "geneticDamEarTagNumber",
          classes: "govuk-input--width-20",
          containerClasses: "app-autocomplete--width-20",
          value: values.geneticDamEarTagNumber,
          label: {
            text: "Animal ear tag number",
            classes: "govuk-label--m"
          },
          hint: {
            text: "Start typing the last 6 digits of the ear tag number and select from the list"
          },
          errorMessage: fieldErrors.geneticDamEarTagNumber,
          items: earTagItems,
          minLength: 1,
          spellcheck: false,
          attributes: { maxlength: maxFieldLength }
        }) }}

        {{ govukButton({
          text: "Continue"
        }) }}
      {% endcall %}
    </div>
  </div>
{% endblock %}
