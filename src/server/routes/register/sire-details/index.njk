{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "form/macro.njk" import lisForm with context %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: backLinkHref
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">Official animal ear tag number: {{ calfEarTagNumber }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      {% call lisForm({ action: formAction }) %}
        {{ govukInput({
          id: "sireEarTagNumber",
          name: "sireEarTagNumber",
          classes: "govuk-!-width-two-thirds",
          value: values.sireEarTagNumber,
          label: {
            text: "Sire ear tag number (optional)",
            classes: "govuk-label--m"
          },
          spellcheck: false,
          attributes: { maxlength: maxFieldLength }
        }) }}

        {{ govukInput({
          id: "sireName",
          name: "sireName",
          classes: "govuk-!-width-two-thirds",
          value: values.sireName,
          label: {
            text: "Sire name (optional)",
            classes: "govuk-label--m"
          },
          attributes: { maxlength: maxFieldLength }
        }) }}

        {{ govukButton({
          text: "Continue",
          preventDoubleClick: true
        }) }}
      {% endcall %}
    </div>
  </div>
{% endblock %}
