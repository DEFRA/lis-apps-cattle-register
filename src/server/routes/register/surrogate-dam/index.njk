{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "form/macro.njk" import lisForm with context %}

{% set earTagHint = "Enter the full animal ear tag number. For example, UK123456123456" %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: backLinkHref
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorList.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorList
        }) }}
      {% endif %}

      <span class="govuk-caption-l">Official animal ear tag number: {{ calfEarTagNumber }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      {% call lisForm({ action: formAction }) %}
        {% include "partials/calf-guard.njk" %}

        {{ govukInput({
          id: "geneticDamEarTagNumber",
          name: "geneticDamEarTagNumber",
          classes: "govuk-input--width-20",
          value: values.geneticDamEarTagNumber,
          label: {
            text: "Genetic dam ear tag number",
            classes: "govuk-label--m"
          },
          hint: {
            text: earTagHint
          },
          errorMessage: fieldErrors.geneticDamEarTagNumber,
          spellcheck: false,
          attributes: { maxlength: maxFieldLength }
        }) }}

        {{ govukInput({
          id: "surrogateDamEarTagNumber",
          name: "surrogateDamEarTagNumber",
          classes: "govuk-input--width-20",
          value: values.surrogateDamEarTagNumber,
          label: {
            text: "Surrogate dam ear tag number",
            classes: "govuk-label--m"
          },
          hint: {
            text: earTagHint
          },
          errorMessage: fieldErrors.surrogateDamEarTagNumber,
          spellcheck: false,
          attributes: { maxlength: maxFieldLength }
        }) }}

        {{ govukButton({
          text: "Continue"
        }) }}
      {% endcall %}
    </div>
  </div>
{% endblock %}
